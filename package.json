{
  "name": "@rayadesu/dsh-window",
  "version": "0.4.2",
  "description": "Session-scoped context window switcher as a DSH composer control (maintained continuation of dsh-context-window-picker)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "context-window",
    "composer-control"
  ],
  "author": "rayadesune",
  "contributors": [
    "luyiheng1111"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rayadesune/dsh-window.git"
  },
  "homepage": "https://github.com/rayadesune/dsh-window#readme",
  "bugs": {
    "url": "https://github.com/rayadesune/dsh-window/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
